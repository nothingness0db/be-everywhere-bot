# Copy to .env and choose your own dashboard login password (12+ characters).
DASHBOARD_PASSWORD=
# Local-only by default. Use an SSH tunnel or an HTTPS reverse proxy to access it.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
# When using an HTTPS reverse proxy, trust only its actual source IP as seen by
# the container. Leave this unchanged when accessing through an SSH tunnel.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
